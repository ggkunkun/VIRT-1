@echo off
REM Virtu PRIMARY Ollama serve on 11434 - explicit env (app.exe auto-start loses OLLAMA_MODELS)
set "OLLAMA_MODELS=E:\migrated\D-MigratedFromC\ollama\models"
set "OLLAMA_HOST=127.0.0.1:11434"
set "OLLAMA_KV_CACHE_TYPE=q4_0"
set "OLLAMA_FLASH_ATTENTION=1"
set "OLLAMA_MAX_LOADED_MODELS=1"
set "OLLAMA_CONTEXT_LENGTH=8192"
set "OLLAMA_NUM_PARALLEL=1"
set "OLLAMA_KEEP_ALIVE=2m"
set "NO_PROXY=*"
set "no_proxy=*"
