%
O1001 (FLANGE DN50 PN16 CNC MACHINING)
(MATERIAL: STEEL 45, BLANK: D170 x L45)
G21 G40 G49 G80 G90

(GLOBAL PARAMETERS)
#100 = 160.0 (FLANGE OD)
#101 = 90.0  (BOSS OD)
#102 = 50.0  (BORE ID)
#103 = 20.0  (DISK THICKNESS)
#104 = 15.0  (BOSS HEIGHT)
#105 = 35.0  (TOTAL LENGTH: #103 + #104)
#106 = 125.0 (BOLT PCD)
#107 = 6.0   (BOLT COUNT)
#108 = 14.0  (BOLT DIA)

(OP1: FACE AND OD TURNING)
G28 U0.0 W0.0
T0101
G96 S180 M03
G00 X172.0 Z2.0 M08
G01 Z0.0 F0.25
G01 X-1.0 F0.18
G00 X172.0 Z2.0

(PARAMETRIC OD ROUGH CYCLE)
#110 = 170.0 (CURRENT OD)
WHILE [#110 GT #100] DO 1
  #110 = #110 - 4.0
  IF [#110 LT #100] THEN #110 = #100
  G00 X#110 Z1.0
  G01 Z-#105 F0.3
  G01 U1.0 Z[-#105+1.0] F0.5
  G00 Z1.0
END 1

(TURN BOSS STEP TO 90MM)
#111 = #100
WHILE [#111 GT #101] DO 2
  #111 = #111 - 4.0
  IF [#111 LT #101] THEN #111 = #101
  G00 X#111 Z1.0
  G01 Z-#104 F0.25
  G01 U1.0 Z[-#104+1.0] F0.5
  G00 Z1.0
END 2

(OP2: BORE HOLE TO 50MM)
G28 U0.0 W0.0
T0303
G97 S600 M03
G00 X0.0 Z3.0
G83 Z[-#105-3.0] Q5000 F0.12
G80

(OP3: PCD 6-HOLE DRILLING CYCLE)
G28 U0.0 W0.0
T0505
G97 S1000 M03
#120 = 0.0 (CURRENT ANGLE)
#121 = 360.0 / #107 (ANGLE STEP)
#122 = 1.0 (INDEX)
WHILE [#122 LE #107] DO 3
  #123 = [#106 / 2.0] * COS[#120] (X POS)
  #124 = [#106 / 2.0] * SIN[#120] (Y POS)
  G00 X[#123*2.0] C#120
  G01 Z-#105 F0.12
  G00 Z2.0
  #120 = #120 + #121
  #122 = #122 + 1.0
END 3

G28 U0.0 W0.0
M09
M05
M30
%
