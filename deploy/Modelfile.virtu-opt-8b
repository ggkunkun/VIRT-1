# 本机适配版：virtu-opt-8b
# 基线模型：virtu-production:latest
# 实测：36.9 tok/s（RTX 4050 Laptop 6GB / i5-12450H / 16GB RAM）
# num_gpu=99  num_ctx=8192  —— 由参数扫描定位的最优点，请勿随意增大 num_gpu
FROM virtu-production:latest

PARAMETER num_gpu 99
PARAMETER num_ctx 8192
PARAMETER num_batch 256
PARAMETER num_thread 10
PARAMETER temperature 0.1
PARAMETER top_p 0.85
PARAMETER top_k 40
PARAMETER repeat_penalty 1.15
