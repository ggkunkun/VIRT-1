(TOOL 04: CARBIDE DRILL D14.0 FOR PCD BOLT HOLES)
(FANUC MACRO B PARAMETRIC ROTARY DRILLING)
(================================================)
N380 T0404
N390 G97 S1200 M03
N400 G00 Z10.0 M08

(MACRO B VARIABLES DEFINITION)
#100 = 62.5      (PCD RADIUS = 125 / 2)
#101 = 0.0       (START ANGLE DEG)
#102 = 60.0      (INDEX ANGLE STEP = 360 / 6)
#103 = 1         (HOLE COUNTER: 1 TO 6)
#104 = 6         (TOTAL HOLE COUNT)

WHILE [#103 LE #104] DO 1
  #110 = #100 * COS[#101]   (X POSITION)
  #111 = #100 * SIN[#101]   (Y POSITION)
  
  (POSITION TO HOLE CENTER)
  G90 G00 X#110 Y#111
  
  (PECK DRILLING CANNED CYCLE G83)
  (Z DEPTH -25.0, R-PLANE 2.0, PECK Q5.0, FEED F120)
  G83 Z-25.0 R2.0 Q5.0 F120
  
  #101 = #101 + #102        (INCREMENT ANGLE)
  #103 = #103 + 1           (INCREMENT COUNTER)
END 1

N410 G80 (CANCEL CANNED CYCLE)
