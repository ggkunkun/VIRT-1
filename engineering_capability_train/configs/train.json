{
  "schema_version": "1.0.0",
  "seed": 20261104,
  "precision_policy": "auto_by_compute_capability: sm>=80 -> bf16, else fp16",
  "profiles": {
    "v100_32g": {
      "quantization": "4bit_nf4_double",
      "bf16": false,
      "fp16": true,
      "flash_attention_2": false,
      "per_device_train_batch_size": 1,
      "gradient_accumulation_steps": 32,
      "max_seq_len": 2048,
      "gradient_checkpointing": true,
      "optim": "paged_adamw_8bit",
      "requirements": "requirements-v100.txt"
    },
    "l40s_48g": {
      "quantization": "4bit_nf4_double",
      "bf16": true,
      "fp16": false,
      "flash_attention_2": false,
      "per_device_train_batch_size": 2,
      "gradient_accumulation_steps": 16,
      "max_seq_len": 2560,
      "gradient_checkpointing": true,
      "optim": "paged_adamw_8bit",
      "requirements": "requirements-l40s.txt"
    },
    "a100_80g": {
      "quantization": "4bit_nf4_double",
      "bf16": true,
      "fp16": false,
      "flash_attention_2": true,
      "per_device_train_batch_size": 4,
      "gradient_accumulation_steps": 8,
      "max_seq_len": 2560,
      "gradient_checkpointing": true,
      "optim": "paged_adamw_8bit",
      "requirements": "requirements-gpu.txt"
    }
  },
  "default_profile": "l40s_48g",
  "sft": {
    "engine": "native",
    "engine_options": ["native", "legacy"],
    "engine_legacy_entry": "scripts/train_qwen3_8b_qlora.py",
    "lora_r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
    "learning_rate": 1.5e-4,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.03,
    "weight_decay": 0.01,
    "num_train_epochs": 3,
    "logging_steps": 10,
    "save_steps": 300,
    "save_total_limit": 2,
    "val_ratio": 0.03,
    "max_grad_norm": 1.0,
    "loss_mask": "assistant_only_official_chat_template",
    "tool_result_masked": true,
    "group_by_length": true
  },
  "dpo": {
    "enabled": true,
    "beta": 0.1,
    "learning_rate": 5.0e-6,
    "num_train_epochs": 1,
    "warmup_ratio": 0.05,
    "lr_scheduler_type": "cosine",
    "max_length": 2048,
    "max_prompt_length": 1536,
    "reference_mode": "peft_disable_adapter",
    "label_smoothing": 0.0,
    "loss_type": "sigmoid",
    "average_logprob": true,
    "notes": "chosen = 物理合规且代价最小的方案；rejected = 违反物理约束 / 更慢 / 随机猜测的负例"
  },
  "merge": {
    "mode": "delta",
    "modes_allowed": ["delta", "ties"],
    "forbidden_modes": ["peft_linear"],
    "reason": "6-LoRA peft_linear 含交叉项，历史上产生乱码与死循环，坏件已隔离 checkpoints/_broken",
    "assert_rank_equal": true,
    "assert_same_base": true,
    "reject_byte_identical_adapters": true
  },
  "runtime_env": {
    "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
    "TOKENIZERS_PARALLELISM": "false",
    "CUDA_VISIBLE_DEVICES": "0"
  }
}
