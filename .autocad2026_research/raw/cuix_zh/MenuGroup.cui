    <MenuMacro UID="MM_0001">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0"/>
        <ModifiedRev MajorVersion="17" MinorVersion="2" UserVersion="0"/>
        <Name xlate="true" UID="XLS_0001">夹点菜单</Name>
        <Command>$M=$(if,$(eq,$(substr,$(getvar,cmdnames),1,5),GRIP_),$P0=ACAD.GRIPS $P0=*); </Command>
        <HelpString xlate="true" UID="XLS_0002"/>
        <CLICommand xlate="true" UID="XLS_CLICMD_MM_0001"/>
        <ToolTip HelpTopic="GRIPS"/>
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_0002">
      <Macro type="Any">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0"/>
        <ModifiedRev MajorVersion="17" MinorVersion="2" UserVersion="0"/>
        <Name xlate="true" UID="XLS_0003">捕捉菜单</Name>
        <Command>$P0=SNAP $p0=* </Command>
        <HelpString xlate="true" UID="XLS_0004"/>
