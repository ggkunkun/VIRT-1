    </MenuMacro>
    <MenuMacro UID="MM_1632">
      <Macro type="Overrides">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0"/>
        <ModifiedRev MajorVersion="16" MinorVersion="2" UserVersion="0"/>
        <Name xlate="true" UID="XLS_1293">禁用所有捕捉和追踪</Name>
        <Command>^P'_.orthomode 0 '_.osmode 0 '_.snapmode 0 '_.autosnap 0 </Command>
        <HelpString xlate="true" UID="XLS_1294"/>
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_1633">
      <Macro type="Overrides">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0"/>
        <ModifiedRev MajorVersion="17" MinorVersion="2" UserVersion="0"/>
        <Name xlate="true" UID="XLS_1295">切换对象捕捉模式</Name>
        <Command>^P'_.osmode $M=$(if,$(and,$(getvar,osmode),16384),$(-,$(getvar,osmode),16384),$(+,$(getvar,osmode),16384)) </Command>
        <HelpString xlate="true" UID="XLS_1296"/>
        <ToolTip HelpTopic="SNAP"/>
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_1634">
      <Macro type="Overrides">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0"/>
        <ModifiedRev MajorVersion="17" MinorVersion="2" UserVersion="0"/>
        <Name xlate="true" UID="XLS_1297">切换正交模式</Name>
        <Command>^P'_.orthomode $M=$(if,$(and,$(getvar,orthomode),1),$(-,$(getvar,orthomode),1),$(+,$(getvar,orthomode),1)) </Command>
        <HelpString xlate="true" UID="XLS_1298"/>
        <ToolTip HelpTopic="orthomode"/>
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_1635">
      <Macro type="Overrides">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0"/>
        <ModifiedRev MajorVersion="17" MinorVersion="2" UserVersion="0"/>
        <Name xlate="true" UID="XLS_1299">切换捕捉模式</Name>
        <Command>^P'_.snapmode $M=$(if,$(and,$(getvar,snapmode),1),$(-,$(getvar,snapmode),1),$(+,$(getvar,snapmode),1)) </Command>
        <HelpString xlate="true" UID="XLS_1300"/>
        <ToolTip HelpTopic="snapmode"/>
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_1636">
      <Macro type="Overrides">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0"/>
        <ModifiedRev MajorVersion="17" MinorVersion="2" UserVersion="0"/>
        <Name xlate="true" UID="XLS_1301">切换极轴模式</Name>
        <Command>^P'_.autosnap $M=$(if,$(and,$(getvar,autosnap),8),$(-,$(getvar,autosnap),8),$(+,$(getvar,autosnap),8)) </Command>
        <HelpString xlate="true" UID="XLS_1302"/>
        <ToolTip HelpTopic="autosnap"/>
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_1637">
      <Macro type="Overrides">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0"/>
        <ModifiedRev MajorVersion="17" MinorVersion="2" UserVersion="0"/>
        <Name xlate="true" UID="XLS_1303">切换对象捕捉追踪模式</Name>
        <Command>^P$M=$(if,$(and,$(getvar,autosnap),16),,$(if,$(and,$(getvar,osmode),16384),'_.osmode $(-,$(getvar,osmode),16384) ))'_.autosnap $(if,$(and,$(getvar,autosnap),16),$(-,$(getvar,autosnap),16),$(+,$(getvar,autosnap),16)) </Command>
        <HelpString xlate="true" UID="XLS_1304"/>
        <ToolTip HelpTopic="SNAP"/>
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_1638">
      <Macro type="Overrides">
        <Revision MajorVersion="16" MinorVersion="2" UserVersion="0"/>
        <ModifiedRev MajorVersion="17" MinorVersion="2" UserVersion="0"/>
        <Name xlate="true" UID="XLS_1305">隐藏动态输入</Name>
        <Command>^P'_.dynmode $M=$(if,$(&gt;,$(getvar,dynmode),0),$(*,$(getvar,dynmode),-1),$(getvar,dynmode))</Command>
        <HelpString xlate="true" UID="XLS_1306">按下指定的临时替代键快捷方式将临时隐藏动态输入 (即 DYNMODE=0)。例如，如果 DYNMODE 系统变量设置为1，则其将临时重置为 0.</HelpString>
        <ToolTip HelpTopic="dynmode"/>
      </Macro>
    </MenuMacro>
    <MenuMacro UID="MM_1639">
      <Macro type="Overrides">
