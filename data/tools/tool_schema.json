[
  {
    "type": "function",
    "function": {
      "name": "cad.parse_wish_intent",
      "description": "将自然语言制造意图解析为结构化参数化 spec；任何代码生成前必须先调用本工具。",
      "parameters": {
        "type": "object",
        "properties": {
          "wish": {
            "type": "string",
            "description": "原始制造意图全文"
          },
          "material": {
            "type": "string",
            "enum": [
              "Ti-6Al-4V",
              "AL7075-T6",
              "Cr12MoV",
              "Steel45",
              "SS304",
              "P20",
              "Inconel718",
              "CuC360",
              "20CrMnTi"
            ],
            "description": "工件材料牌号"
          },
          "d_outer": {
            "type": "number",
            "description": "最大外径 mm"
          },
          "d_inner": {
            "type": "number",
            "description": "轴心通孔/内孔直径 mm，必须小于 d_outer"
          },
          "num_features": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "槽/叶片/阵列特征数量"
          },
          "fillet_r": {
            "type": "number",
            "description": "槽底圆角 R mm"
          },
          "overall_len": {
            "type": "number",
            "description": "总长 mm"
          },
          "sweep_angle": {
            "type": "number",
            "description": "摆角/螺旋角 deg"
          },
          "is_multiaxis": {
            "type": "boolean",
            "description": "是否需五轴联动"
          },
          "is_die_mold": {
            "type": "boolean",
            "description": "是否为模具类工件"
          }
        },
        "required": [
          "wish",
          "material",
          "d_outer",
          "d_inner"
        ]
      }
    }
  },
