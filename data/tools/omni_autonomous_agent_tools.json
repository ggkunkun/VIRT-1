          },
          "verified_code_template": {
            "type": "string",
            "description": "经过自优化验证的标准代码片段"
          }
        },
        "required": [
          "task_signature",
          "problem_summary",
          "solution_strategy",
          "key_rules_learned"
        ]
      }
    }
  },
