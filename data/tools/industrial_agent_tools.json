        "type": "object",
        "properties": {
          "start_x": {
            "type": "integer",
            "description": "起点坐标 X"
          },
          "start_y": {
            "type": "integer",
            "description": "起点坐标 Y"
          },
          "end_x": {
            "type": "integer",
            "description": "终点坐标 X"
          },
          "end_y": {
            "type": "integer",
            "description": "终点坐标 Y"
          },
          "button": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "middle"
            ],
            "default": "left"
          }
        },
        "required": [
          "start_x",
          "start_y",
          "end_x",
          "end_y"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "desktop.mouse_scroll",
      "description": "在指定位置滚动鼠标滚轮，进行CAD模型视图缩放或列表滚动。",
      "parameters": {
        "type": "object",
        "properties": {
          "clicks": {
            "type": "integer",
            "description": "滚动格数（正数向上放大，负数向下缩小）"
          },
          "x": {
            "type": "integer",
            "description": "鼠标停留横坐标"
          },
          "y": {
            "type": "integer",
            "description": "鼠标停留纵坐标"
          }
        },
        "required": [
          "clicks"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "desktop.type_text",
      "description": "向当前活动窗口输入文本内容（经剪贴板注入，支持长文本与特殊符号）。",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "待输入的文本内容"
          }
        },
        "required": [
          "text"
        ]
      }
    }
  },
  {
    "type": "function",
